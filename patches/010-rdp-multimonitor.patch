+/**
+ * The size, in bytes, of the buffer used to build the "multimon-layout" JSON.
+ * A handful of small integer rects, so this fixed bound is sufficient.
+ */
+#define GUAC_RDP_MULTIMON_LAYOUT_SIZE 512
+
+/**
+ * Recomputes the left offset of each active monitor (tiled left-to-right,
+ * top-aligned), clamping and rounding each dimension to comply with the
+ * Display Control channel restrictions, and stores the resulting combined
+ * desktop dimensions as the requested size.
+ */
+static void guac_rdp_disp_recalc(guac_rdp_disp* disp) {
+
+    int left = 0;
+    int max_height = 0;
+
+    for (int i = 0; i < disp->monitor_count; i++) {
+
+        int width  = disp->monitors[i].width;
+        int height = disp->monitors[i].height;
+
+        /* Clamp to the allowed range and round down to a multiple of 16 (RDP
+         * requires even monitor widths; mod-16 also avoids H.264 macroblock
+         * padding artifacts along the bottom/right edges) */
+        if (width  > GUAC_RDP_DISP_MAX_SIZE) width  = GUAC_RDP_DISP_MAX_SIZE;
+        if (height > GUAC_RDP_DISP_MAX_SIZE) height = GUAC_RDP_DISP_MAX_SIZE;
+        width  -= width  % 16;
+        height -= height % 16;
+        if (width  < GUAC_RDP_DISP_MIN_SIZE) width  = GUAC_RDP_DISP_MIN_SIZE;
+        if (height < GUAC_RDP_DISP_MIN_SIZE) height = GUAC_RDP_DISP_MIN_SIZE;
+
+        disp->monitors[i].width  = width;
+        disp->monitors[i].height = height;
+        disp->monitors[i].left   = left;
+
+        left += width;
+        if (height > max_height) max_height = height;
+
+    }
+
+    /* The combined desktop is the bounding box of all monitors */
+    disp->requested_width  = left;
+    disp->requested_height = max_height;
+
+}
+
+/**
+ * Publishes the current monitor layout to the connected client as a JSON
+ * "multimon-layout" parameter on the default layer, so a multi-monitor client
+ * can split the combined framebuffer into per-monitor windows.
+ */
+static void guac_rdp_disp_publish_layout(guac_rdp_disp* disp) {
+
+    guac_client* client = disp->client;
+
+    if (disp->monitor_count <= 0)
+        return;
+
+    char json[GUAC_RDP_MULTIMON_LAYOUT_SIZE];
+    int pos = 0;
+
+    pos += snprintf(json + pos, sizeof(json) - pos, "{");
+    for (int i = 0; i < disp->monitor_count && pos < (int) sizeof(json) - 1; i++) {
+        pos += snprintf(json + pos, sizeof(json) - pos,
+                "%s\"%d\":{\"left\":%d,\"top\":0,\"width\":%d,\"height\":%d}",
+                (i ? "," : ""), i, disp->monitors[i].left,
+                disp->monitors[i].width, disp->monitors[i].height);
+    }
+    if (pos < (int) sizeof(json) - 1)
+        snprintf(json + pos, sizeof(json) - pos, "}");
+
+    guac_protocol_send_set(client->socket, GUAC_DEFAULT_LAYER,
+            GUAC_PROTOCOL_LAYER_PARAMETER_MULTIMON_LAYOUT, json);
+    guac_socket_flush(client->socket);
+
+    guac_client_log(client, GUAC_LOG_DEBUG,
+            "multimon-layout published (%d monitor(s)): %s",
+            disp->monitor_count, json);
+
+}
+
+void guac_rdp_disp_set_monitor(guac_rdp_disp* disp, guac_rdp_settings* settings,
+        freerdp* rdp_inst, int index, int width, int height) {
+
+    if (disp == NULL)
+        return;
+
+    /* Number of monitors permitted (primary plus configured secondaries),
+     * capped at the number of heads supported */
+    int max_monitors = settings->max_secondary_monitors + 1;
+    if (max_monitors > GUAC_RDP_MAX_MONITORS)
+        max_monitors = GUAC_RDP_MAX_MONITORS;
+
+    /* Ensure the primary monitor exists before any secondary is referenced */
+    if (disp->monitor_count < 1)
+        disp->monitor_count = 1;
+
+    /* A positive size adds or updates the monitor at the given index */
+    if (width > 0 && height > 0) {
+
+        /* Ignore out-of-range indexes and refuse to create a gap in the
+         * (contiguous) layout */
+        if (index < 0 || index >= max_monitors || index > disp->monitor_count)
+            return;
+
+        disp->monitors[index].width  = width;
+        disp->monitors[index].height = height;
+
+        /* Grow the active count if this request adds a new monitor */
+        if (index == disp->monitor_count)
+            disp->monitor_count = index + 1;
+
+    }
+
+    /* A non-positive size removes the secondary monitor at the given index,
+     * shifting any monitors to its right down to keep the layout contiguous.
+     * The primary monitor (index 0) cannot be removed. */
+    else {
+
+        if (index <= 0 || index >= disp->monitor_count)
+            return;
+
+        for (int i = index; i < disp->monitor_count - 1; i++)
+            disp->monitors[i] = disp->monitors[i + 1];
+
+        disp->monitor_count--;
+
+    }
+
+    guac_rdp_disp_recalc(disp);
+
+    /* Send the updated layout to the server (and republish to the client) */
+    guac_rdp_disp_update_size(disp, settings, rdp_inst);
+
+}
