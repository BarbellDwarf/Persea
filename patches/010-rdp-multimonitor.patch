+ * @param width
+ *     The desired monitor width in pixels, or a non-positive value to remove
+ *     the monitor.
+ *
+ * @param height
+ *     The desired monitor height in pixels.
+ */
+void guac_rdp_disp_set_monitor(guac_rdp_disp* disp, guac_rdp_settings* settings,
+        freerdp* rdp_inst, int index, int width, int height);
