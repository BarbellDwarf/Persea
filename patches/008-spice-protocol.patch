+    emit(f, "sync", "1000", NULL);
+    emit(f, "clipboard", "1", "text/plain", NULL);
+    emit_blob(f, "1", "data", 4);
+    emit(f, "end", "1", NULL);
+    fclose(f);
+
+    CU_ASSERT_EQUAL(run_interpret(&ws, default_opts()), 0);
