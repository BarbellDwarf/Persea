diff --git a/src/protocols/spice/channels.c b/src/protocols/spice/channels.c
new file mode 100644
index 00000000..6d16e2ce
--- /dev/null
+++ b/src/protocols/spice/channels.c
@@ -0,0 +1,273 @@
+/*
