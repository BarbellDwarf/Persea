+    emit(f, "sync", "1000", NULL);
+    emit(f, "clipboard", "1", "text/plain", NULL);
+    /* Emit a raw, deliberately-malformed base64 payload */
+    emit(f, "blob", "1", "!!!!not-valid-base64", NULL);
+    emit(f, "end", "1", NULL);
