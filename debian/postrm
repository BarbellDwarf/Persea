#!/bin/sh
set -e

# Update shared library cache
ldconfig

# On purge, remove runtime data and user
if [ "$1" = "purge" ]; then
    rm -rf /opt/persea/data
    rm -rf /opt/persea/recordings
    rm -rf /opt/persea/tls
    rm -rf /opt/persea
    rm -f /etc/ld.so.conf.d/persea.conf
    ldconfig

    if getent passwd persea >/dev/null 2>&1; then
        deluser --quiet --system persea || true
    fi
    if getent group persea >/dev/null 2>&1; then
        delgroup --quiet --system persea || true
    fi
fi

#DEBHELPER#

exit 0
