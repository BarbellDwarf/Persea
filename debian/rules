#!/usr/bin/make -f

export DH_VERBOSE = 1

DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)

%:
	dh $@

# Everything is pre-built by build-deb.sh — no configure or build steps needed.
override_dh_auto_configure:

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_install:
	# Create directory structure
	install -d debian/persea/opt/persea/bin
	install -d debian/persea/opt/persea/sbin
	install -d debian/persea/opt/persea/lib
	install -d debian/persea/opt/persea/static
	install -d debian/persea/opt/persea/static/guac
	install -d debian/persea/opt/persea/data
	install -d debian/persea/opt/persea/recordings
	install -d debian/persea/opt/persea/tls
	install -d debian/persea/etc/ld.so.conf.d

	# persea binary
	install -m 755 target/release/persea debian/persea/opt/persea/bin/persea

	# Drive setup helper script
	install -m 755 scripts/drive-setup.sh debian/persea/opt/persea/bin/drive-setup.sh

	# guacd binary and libraries from staging
	install -m 755 debian/staging/opt/persea/sbin/guacd debian/persea/opt/persea/sbin/guacd
	cp -a debian/staging/opt/persea/lib/*.so* debian/persea/opt/persea/lib/

	# FreeRDP plugin for RDPDR/RDPSND channels (drive redirection, audio, printing)
	install -d debian/persea/usr/lib/$(DEB_HOST_MULTIARCH)/freerdp3
	cp -a debian/staging/usr/lib/$(DEB_HOST_MULTIARCH)/freerdp3/*.so* debian/persea/usr/lib/$(DEB_HOST_MULTIARCH)/freerdp3/ 2>/dev/null || true

	# Static web assets
	cp -r static/* debian/persea/opt/persea/static/

	# Default config (marked as conffile)
	install -m 644 debian/config.toml.default debian/persea/opt/persea/config.toml

	# ldconfig drop-in so guacd can find its libs
	echo "/opt/persea/lib" > debian/persea/etc/ld.so.conf.d/persea.conf

override_dh_shlibdeps:
	dh_shlibdeps -l/opt/persea/lib

# dh_dwz fails on Rust binaries
override_dh_dwz:

# Don't generate separate debug symbol packages
override_dh_strip:
	dh_strip --no-automatic-dbgsym

# Install both systemd services
override_dh_installsystemd:
	dh_installsystemd --name=persea-guacd
	dh_installsystemd --name=persea
